{
  "manifest_version": 3,
  "name": "Chrome Bridge",
  "version": "0.1.0",
  "description": "Lets local agent tools (MCP) manage bookmarks and tab groups over an authenticated localhost bridge.",
  "minimum_chrome_version": "120",
  "permissions": ["bookmarks", "tabs", "tabGroups", "alarms", "storage"],
  "host_permissions": ["ws://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Chrome Bridge", "default_popup": "popup.html" }
}
